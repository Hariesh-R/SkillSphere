# ============================================================
# SkillSphere Backend – Environment Variables
# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.
# ============================================================

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173

# ──────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ──────────────────────────────────────────────
# Database
# DB_DRIVER options: sqlite | azure-sql  (azure-sql: Not implemented yet)
# ──────────────────────────────────────────────
DB_DRIVER=sqlite
SQLITE_FILE=./data/skillsphere.db

# ──────────────────────────────────────────────
# Storage
# STORAGE_DRIVER options: local | azure-blob  (azure-blob: Not implemented yet)
# ──────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads

# ──────────────────────────────────────────────
# Azure SQL Database – Not implemented yet
# Uncomment and populate when migrating to Azure SQL
# ──────────────────────────────────────────────
# AZURE_SQL_SERVER=your-server.database.windows.net    # Not implemented yet
# AZURE_SQL_DATABASE=skillsphere                       # Not implemented yet
# AZURE_SQL_USER=your-db-user                          # Not implemented yet
# AZURE_SQL_PASSWORD=your-db-password                  # Not implemented yet

# ──────────────────────────────────────────────
# Azure Blob Storage – Not implemented yet
# Uncomment and populate when migrating to Azure Blob Storage
# ──────────────────────────────────────────────
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...  # Not implemented yet
# AZURE_STORAGE_CONTAINER=skillsphere-uploads                                      # Not implemented yet
